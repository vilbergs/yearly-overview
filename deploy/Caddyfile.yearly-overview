# Import this site from /etc/caddy/Caddyfile. See caddy.md for prerequisites.
# Replace the hostname and the Pi's Tailscale address (`tailscale ip -4`) with your own.
planner.example.com {
	bind 100.64.0.1
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	reverse_proxy 127.0.0.1:8080
}
