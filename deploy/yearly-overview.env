# Settings for the yearly-overview service. Restart after editing:
#   sudo systemctl restart yearly-overview
# This file holds the database password: keep it readable by root only (chmod 600).

# Listen on localhost only; Caddy (or `tailscale serve`) publishes it over HTTPS.
# Use 0.0.0.0:8080 only if you put it behind another reverse proxy on a different machine.
BIND_ADDR=127.0.0.1:8080

# PostgreSQL connection. `sudo ./install.sh --create-database` creates the role and database
# and fills this in for you.
DATABASE_URL=postgres://yearly_overview:CHANGE_ME@localhost/yearly_overview

STATIC_DIR=/opt/yearly-overview/build

# Nightly pg_dump backups in /var/lib/yearly-overview/backups (see yearly-overview-backup.timer).
BACKUP_KEEP=14

# There is no login: anyone who can reach the server can read and edit the planner.
# If the port is reachable by more than your own devices (e.g. BIND_ADDR=0.0.0.0), list the
# host names you use to open it, so other websites can't reach it via DNS rebinding:
# ALLOWED_HOSTS=raspberrypi.your-tailnet.ts.net,raspberrypi

RUST_LOG=info
